{
  "name": "@oms/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@oms/contracts": "0.1.0",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "express": "5",
    "pino": "10",
    "zod": "4"
  },
  "devDependencies": {
    "@types/express": "5",
    "@types/node": "24",
    "@types/supertest": "6",
    "prisma": "7",
    "supertest": "7",
    "tsx": "4",
    "vitest": "4"
  }
}
