{
  "name": "oms",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": { "effect": "3.22.5" }
  },
  "scripts": {
    "release:check": "node scripts/release-notes.mjs",
    "staff:bootstrap": "node --env-file-if-exists=.env --import tsx apps/api/src/access/bootstrap.ts",
    "test:access": "npm run test:access -w @oms/api",
    "dev:api": "npm run dev -w @oms/api",
    "dev:web": "npm run dev -w @oms/web",
    "db:generate": "npm run db:generate -w @oms/api",
    "db:migrate": "npm run db:migrate -w @oms/api",
    "setup": "npm run db:generate && npm run build -w @oms/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @oms/contracts && npm run build -w @oms/api && npm run build -w @oms/web"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
